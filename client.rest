@baseUrl = http://localhost:3000

# RECADOS
### Lista todos os recados
GET {{baseUrl}}/recados/
?limit=100
&offset=50

### Lista apenas o recado pelo id
GET {{baseUrl}}/recados/2/

### Cria um recado
POST {{baseUrl}}/recados/
Content-Type: application/json

{
  "texto": "Novo recado",
  "de": "Vicente",
  "para": "Maria",
  "lido": false,
  "data": "2026-11-14T23:48:11.008Z"
}

### Atualiza um recado
PATCH  {{baseUrl}}/recados/2/
Content-Type: application/json

{
  "texto": "Recado",
  "bla bla": 123456
  
}

### Apaga um recado
DELETE {{baseUrl}}/recados/3/

